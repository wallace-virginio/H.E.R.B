/* H.E.R.B. — tema discreto estilo overlay */

QWidget#HerbRoot {
    background-color: rgba(10, 16, 24, 230);
    border: 1px solid rgba(64, 196, 255, 90);
    border-radius: 14px;
    color: #E8F1F8;
    font-family: "Segoe UI", "Cascadia Code", sans-serif;
}

QLabel#TitleLabel {
    color: #5CD6FF;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#StatusLabel {
    color: #9BB4C8;
    font-size: 12px;
}

QListWidget#ChatList {
    background: rgba(0, 0, 0, 80);
    border: 1px solid rgba(255, 255, 255, 25);
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QListWidget#ChatList::item {
    padding: 8px;
    margin: 3px 0;
    border-radius: 8px;
}

QLineEdit#InputField {
    background: rgba(255, 255, 255, 18);
    border: 1px solid rgba(92, 214, 255, 80);
    border-radius: 10px;
    padding: 10px 12px;
    color: #E8F1F8;
    selection-background-color: #1F6FEB;
}

QPushButton {
    background: rgba(32, 120, 170, 180);
    border: 1px solid rgba(92, 214, 255, 100);
    border-radius: 10px;
    padding: 8px 12px;
    color: #EAF7FF;
    font-weight: 600;
}

QPushButton:hover {
    background: rgba(40, 150, 210, 220);
}

QPushButton:pressed {
    background: rgba(20, 90, 130, 220);
}

QPushButton#DangerButton {
    background: rgba(160, 40, 40, 180);
    border: 1px solid rgba(255, 120, 120, 120);
}

QPushButton#MicButton[listening="true"] {
    background: rgba(20, 140, 90, 200);
}

QLabel#Indicator {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 15);
}

QLabel#Indicator[active="true"] {
    background: rgba(40, 180, 120, 160);
    color: #E8FFE8;
}
